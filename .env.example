# Variaveis de ambiente da API. NAO coloque os valores reais em nenhum arquivo do projeto:
# defina-as no Windows (ou no painel do Render). Este arquivo so lista os nomes.

# Obrigatorias - conexao com o Oracle da FIAP
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USER=
DB_PASSWORD=

# Opcionais
# Segredo que assina o token de sessao (qualquer texto longo e aleatorio)
APP_TOKEN_SECRET=


# Porta local (o Render define sozinho)
PORT=8080
